---
import { SITE } from '../config/site';
import { withBase } from '../lib/base';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy reveal">
      <h1 class="hero__title">{SITE.tagline}</h1>
      <p class="lead">
        MELA reconstructs lineage trees across more than 1.5 million cells from
        16 mouse embryos, staged at half-day intervals from E7.5 to E10.0, and
        pairs them with deep transcriptional profiling to chart how cell fate is
        decided during gastrulation and early organogenesis.
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary" href={withBase('/explore')}>Explore the data</a>
        <a class="btn btn-ghost" href={SITE.paperUrl} target="_blank" rel="noopener">
          Read the paper ↗
        </a>
        <a class="btn btn-ghost" href={withBase('/download')}>Download →</a>
      </div>
    </div>

    <div class="hero__art reveal">
      <img
        src={withBase('/img/website_umap_v1.webp')}
        alt="UMAP of the MELA single-cell transcriptomic atlas, colored by cell type"
        width="1279"
        height="1271"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.75rem, 1rem + 2vw, 3rem) clamp(1.125rem, 0.375rem + 2.25vw, 2.625rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 0.98fr;
    gap: clamp(0.75rem, 0.25rem + 1.4vw, 2rem);
    align-items: center;
  }
  .hero__title {
    font-size: var(--fs-display);
    margin: 0 0 1rem;
  }
  .hero__copy .lead {
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero__art {
    animation-delay: 0.1s;
  }
  .hero__art img {
    width: 100%;
    height: auto;
    max-width: 560px;
    margin-inline: 0 auto;
    display: block;
    border-radius: var(--r-lg);
  }
  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__art {
      order: -1;
      max-width: 360px;
    }
  }
</style>
