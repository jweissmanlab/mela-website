---
import Base from '../layouts/Base.astro';
import LinkageHeatmap from '../components/LinkageHeatmap';
---

<Base
  title="Linkage"
  description="Interactive heatmap of ancestral linkage between cell types across stages."
>
  <section class="section container">
    <div class="head prose">
      <p class="eyebrow">Linkage</p>
      <h1>Ancestral linkage</h1>
      <p class="lead">
        Each cell shows the normalized ancestral linkage between a pair of cell
        populations — how much more (red) or less (blue) they share clonal
        ancestry than expected. Choose a stage and resolution with the dropdowns;
        colored strips along the top and right mark each population's lineage.
        Click a cell for its p-value and variance, or click a lineage to isolate
        it.
      </p>
    </div>

    <div class="card panel">
      <LinkageHeatmap client:load />
    </div>
  </section>
</Base>

<style>
  .head {
    margin-bottom: 2rem;
  }
  .panel {
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
  }
</style>
