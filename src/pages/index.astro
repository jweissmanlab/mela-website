---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { STATS, CITATION, SITE } from '../config/site';
import { withBase } from '../lib/base';

const cards = [
  {
    href: '/explore',
    title: 'Explore',
    body: 'Browse the full single-cell atlas interactively with CELLxLINEAGE.',
  },
  {
    href: '/linkage',
    title: 'Linkage',
    body: 'An interactive heatmap of ancestral linkage between cell types.',
  },
  {
    href: '/fate',
    title: 'Fate',
    body: 'A Sankey of lineage restriction from uncommitted cells to cell types.',
  },
  {
    href: '/celltypes',
    title: 'Cell types',
    body: 'The cell-type hierarchy with UMAPs, markers, and lineage statistics.',
  },
  {
    href: '/programs',
    title: 'Gene programs',
    body: 'Covarying gene programs and their pairwise correlation structure.',
  },
  {
    href: '/download',
    title: 'Download',
    body: 'Get the processed data and lineage trees from the Zenodo archive.',
  },
];
---

<Base>
  <Hero />

  <!-- stat tiles -->
  <section class="container">
    <div class="stats">
      {
        STATS.map((s) => (
          <div class="stat">
            <div class="stat__value">{s.value}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- full-width lineage trees -->
  <section class="tree-band">
    <img
      src={withBase('/img/website_trees_v1.webp')}
      alt="Reconstructed lineage trees across MELA mouse embryos"
      width="2534"
      height="1352"
      loading="lazy"
      decoding="async"
    />
    <p class="tree-band__cap">
      Reconstructed lineage trees resolving ~75% of cell divisions across 16 embryos.
    </p>
  </section>

  <!-- overview -->
  <section class="section container">
    <div class="grid-2">
      <div>
        <p class="eyebrow">The project</p>
        <h2>A quantitative framework for cell fate specification</h2>
      </div>
      <div class="prose">
        <p>
          A comprehensive cell fate map of mammalian embryogenesis has long been
          out of reach because of the scale, cellular diversity, and
          non-deterministic nature of development in utero. Using PEtracer to
          continuously install heritable genetic marks as cells divide, we
          reconstruct lineage trees that resolve roughly 75% of cell divisions.
        </p>
        <p>
          Pairing these trees with deep transcriptional profiling, we quantify
          fate biases, restriction timing, progenitor pool sizes, and lineage
          relationships across the embryo — revealing strikingly reproducible
          lineage architecture across replicate embryos despite the regulative
          flexibility of mammalian development. The result is a lineage-resolved
          reference for generating and contextualizing developmental hypotheses
          at organismal scale.
        </p>
      </div>
    </div>
  </section>

  <!-- explore cards -->
  <section class="section container">
    <p class="eyebrow">What you'll find here</p>
    <div class="cards">
      {
        cards.map((c) => (
          <a class="card explore-card" href={withBase(c.href)}>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <span class="explore-card__go">Open →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- citation -->
  <section class="section container">
    <div class="cite card">
      <p class="eyebrow">Cite this work</p>
      <p class="cite__text">
        {CITATION.authors}. <em>{CITATION.title}.</em> {CITATION.journal} ({CITATION.year}).
      </p>
      <p class="cite__doi">
        doi:{' '}
        <a href={CITATION.url} target="_blank" rel="noopener noreferrer">{CITATION.doi}</a>
      </p>
      <a class="btn btn-ghost" href={withBase('/download')}>Data &amp; citation →</a>
    </div>
  </section>

  <!-- funding -->
  <section class="section container">
    <div class="funding card">
      <div class="funding__text">
        <p class="eyebrow">Funding</p>
        <p>
          The generation of this data was supported by the
          <strong>CZ Biohub Billion Cells Project</strong>, the
          <strong>Howard Hughes Medical Institute</strong>, and an
          <strong>NIH Center of Excellence in Genomic Science (CEGS)</strong> award.
        </p>
      </div>
      <div class="funding__logos">
        <a
          class="funding__logo"
          href="https://www.czbiohub.org/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CZ Biohub"
        >
          <img
            src={withBase('/img/biohub-logo@4x.png')}
            alt="CZ Biohub"
            width="524"
            height="164"
          />
        </a>
        <a
          class="funding__logo"
          href="https://www.hhmi.org/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Howard Hughes Medical Institute"
        >
          <img
            src={withBase('/img/HHMI-vertical-signature-color.jpg')}
            alt="Howard Hughes Medical Institute"
            width="883"
            height="574"
          />
        </a>
        <a
          class="funding__logo"
          href="https://www.genome.gov/Funded-Programs-Projects/Centers-of-Excellence-in-Genomic-Science"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="NIH Center of Excellence in Genomic Science"
        >
          <img
            src={withBase('/img/NIH_Master_Logo_Vertical_2Color.png')}
            alt="NIH Center of Excellence in Genomic Science"
            width="374"
            height="329"
          />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tree-band {
    max-width: var(--max-w);
    margin: clamp(2.25rem, 1.5rem + 3vw, 4.5rem) auto clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-inline: var(--gutter);
  }
  .tree-band img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--r-lg);
  }
  .tree-band__cap {
    margin-top: 0.85rem;
    font-size: var(--fs-small);
    color: var(--ink-3);
    text-align: center;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .stat {
    background: #fff;
    padding: 1.6rem 1.4rem;
  }
  .stat__value {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.5rem);
    color: var(--accent-ink);
    line-height: 1;
  }
  .stat__label {
    margin-top: 0.5rem;
    color: var(--ink-3);
    font-size: var(--fs-small);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .explore-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: var(--ink);
    transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }
  .explore-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
    color: var(--ink);
  }
  .explore-card h3 {
    margin-bottom: 0.35rem;
  }
  .explore-card p {
    color: var(--ink-2);
    font-size: var(--fs-small);
    flex: 1;
  }
  .explore-card__go {
    margin-top: 1rem;
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .funding {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .funding__text {
    max-width: 52ch;
  }
  .funding__text p:last-child {
    margin: 0;
    font-size: 1.1rem;
    color: var(--ink-2);
  }
  .funding__logos {
    flex: none;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .funding__logo {
    flex: none;
    display: block;
  }
  .funding__logo img {
    width: auto;
    height: 52px;
    display: block;
  }

  .cite {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .cite__text {
    font-size: 1.15rem;
    max-width: 60ch;
  }
  .cite__doi {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }
  .cite__note {
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-2 {
      grid-template-columns: 1fr;
    }
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
