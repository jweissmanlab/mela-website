---
import Base from '../layouts/Base.astro';
import { SITE, CITATION } from '../config/site';

const embryos = [
  { file: 'E7.5-R1.h5td', stage: 'E7.5', replicate: 'R1', size: '97.2 MB' },
  { file: 'E7.5-R2.h5td', stage: 'E7.5', replicate: 'R2', size: '116.4 MB' },
  { file: 'E7.5-R3.h5td', stage: 'E7.5', replicate: 'R3', size: '104.5 MB' },
  { file: 'E8.0-R1.h5td', stage: 'E8.0', replicate: 'R1', size: '233.3 MB' },
  { file: 'E8.0-R2.h5td', stage: 'E8.0', replicate: 'R2', size: '389.9 MB' },
  { file: 'E8.0-R3.h5td', stage: 'E8.0', replicate: 'R3', size: '311.3 MB' },
  { file: 'E8.5-R1.h5td', stage: 'E8.5', replicate: 'R1', size: '1.4 GB' },
  { file: 'E8.5-R2.h5td', stage: 'E8.5', replicate: 'R2', size: '2.2 GB' },
  { file: 'E8.5-R3.h5td', stage: 'E8.5', replicate: 'R3', size: '1.5 GB' },
  { file: 'E9.0-R1.h5td', stage: 'E9.0', replicate: 'R1', size: '4.2 GB' },
  { file: 'E9.0-R2.h5td', stage: 'E9.0', replicate: 'R2', size: '5.2 GB' },
  { file: 'E9.0-R3.h5td', stage: 'E9.0', replicate: 'R3', size: '3.3 GB' },
  { file: 'E9.5-R1.h5td', stage: 'E9.5', replicate: 'R1', size: '17.5 GB' },
  { file: 'E9.5-R2.h5td', stage: 'E9.5', replicate: 'R2', size: '13.3 GB' },
  { file: 'E9.5-R3.h5td', stage: 'E9.5', replicate: 'R3', size: '13.0 GB' },
  { file: 'E10.0-R1.h5td', stage: 'E10.0', replicate: 'R1', size: '17.4 GB' },
];

const bibtex = `@article{colgan${CITATION.year}mela,
  title   = {${CITATION.title}},
  author  = {${CITATION.authors}},
  journal = {${CITATION.journal}},
  year    = {${CITATION.year}},
  doi     = {${CITATION.doi}},
  url     = {${CITATION.url}}
}`;
---

<Base title="Download" description="Download the MELA dataset from Zenodo.">
  <section class="section container">
    <div class="head prose">
      <p class="eyebrow">Download</p>
      <h1>Data &amp; archive</h1>
      <p class="lead">
        Per-embryo H5TD files — gene expression counts, cell metadata, and
        lineage trees — are archived on Zenodo. Each box below links directly
        to that embryo's file for download.
      </p>
      <a class="btn btn-primary" href={SITE.zenodoRecordUrl} target="_blank" rel="noopener">
        Open Zenodo record ↗
      </a>
    </div>

    <p class="tools-note">
      H5TD files containing gene expression counts, cell meta data, and
      lineage trees can be loaded using{' '}
      <a href="https://treedata.readthedocs.io/en/latest/index.html" target="_blank" rel="noopener noreferrer">TreeData</a>{' '}
      and analyzed using{' '}
      <a href="https://pycea.readthedocs.io/en/latest/" target="_blank" rel="noopener noreferrer">Pycea</a>,
      or visualized directly using{' '}
      <a href="https://github.com/colganwi/cellxlineage" target="_blank" rel="noopener noreferrer">CELLxLINEAGE</a>.
    </p>

    <ul class="files">
      {
        embryos.map((e) => (
          <li class="card file">
            <div class="file__main">
              <h3>{e.stage} · {e.replicate}</h3>
            </div>
            <div class="file__meta">
              <span class="tag">h5td</span>
              <span class="file__size">{e.size}</span>
              <a
                class="btn btn-ghost"
                href={`${SITE.zenodoRecordUrl}/files/${e.file}?download=1`}
                target="_blank"
                rel="noopener"
              >
                Download ↗
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="cite-block card">
      <p class="eyebrow">Cite this dataset</p>
      <p class="cite-block__ref">
        {CITATION.authors}. <em>{CITATION.title}.</em> {CITATION.journal} ({CITATION.year}).
        doi:<a href={CITATION.url} target="_blank" rel="noopener noreferrer">{CITATION.doi}</a>
      </p>
      <details>
        <summary>BibTeX</summary>
        <pre>{bibtex}</pre>
      </details>
    </div>
  </section>
</Base>

<style>
  .head {
    margin-bottom: 2.5rem;
  }
  .tools-note {
    margin: 0 0 2rem;
    font-size: var(--fs-body);
    color: var(--ink-2);
    max-width: none;
  }
  .tools-note a {
    color: var(--accent);
    font-weight: 600;
  }
  code {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--paper-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .files {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .file {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem 1.5rem;
    flex-wrap: wrap;
  }
  .file__main {
    flex: 1;
    min-width: 240px;
  }
  .file__main h3 {
    margin: 0;
  }
  .file__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .tag {
    font-family: var(--mono);
    font-size: var(--fs-tiny);
    color: var(--accent-ink);
    background: var(--accent-tint);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  .file__size {
    font-size: var(--fs-small);
    color: var(--ink-3);
    white-space: nowrap;
  }
  .cite-block {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .cite-block__ref {
    font-size: 1.1rem;
    max-width: 62ch;
  }
  details summary {
    cursor: pointer;
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  pre {
    background: var(--ink);
    color: #eee;
    padding: 1rem;
    border-radius: var(--r-sm);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: var(--fs-small);
    line-height: 1.5;
    margin-top: 0.75rem;
  }
</style>
